# Variables de entorno del proyecto
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MODEL_NAME=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=es
PIPER_MODEL=backend/data/tts/es_MX-claude-high.onnx
PIPER_CONFIG=backend/data/tts/es_MX-claude-high.onnx.json
RAG_COLLECTION=techsphere
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_TRUST_REMOTE_CODE=true
HASH_EMBEDDING_DIMENSIONS=256

# Tarifas de referencia para el costo estimado por llamada (README §Métricas).
# Verifica la tarifa vigente en Google AI Studio / Groq Console antes de citarlas
# como definitivas en el informe final.
GEMINI_INPUT_PRICE_PER_1M_USD=0.15
GEMINI_OUTPUT_PRICE_PER_1M_USD=0.60
GROQ_STT_PRICE_PER_MINUTE_USD=0.00463
AVG_AUDIO_TURN_SECONDS=8
