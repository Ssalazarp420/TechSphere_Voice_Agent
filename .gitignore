# LibreOffice/OpenOffice lock files — embed local username and LAN IP of whoever
# has the spreadsheet open, never useful to commit.
.~lock.*#

# Python bytecode cache
__pycache__/
*.pyc

# Entornos virtuales y secretos
.venv/
.env
.venv/

# Archivos temporales
*.log

# Artefactos generados por el proyecto
backend/data/call_sessions.json
backend/data/metrics_snapshot.json
backend/data/smoke_test_report.json
